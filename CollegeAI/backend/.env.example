# CollegeAI FastAPI Backend Environment Configuration
# Copy this file to .env and fill in real credentials. Never commit .env to GitHub.

APP_NAME="CollegeAI — VETIAS Admissions API"
ENVIRONMENT="development"

# PostgreSQL + pgvector Connection String
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/collegeai_db"

# Google Gemini API Key (server-side only)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_CHAT_MODEL="gemini-4-hydrogen"
GEMINI_EMBEDDING_MODEL="gemini-embedding-2"

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"
